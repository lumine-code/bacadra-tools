'context-menu':
  '.tree-view-root:not(.multi-select) .directory > .header': [
    { 'label': 'Open in This Window', 'command':'bacadra-tools:open-in-this-window' }
    { 'label': 'Create .gitignore', 'command':'bacadra-tools:create-gitignore' }
  ]
  '.tree-view-root:not(.multi-select) .file': [
    { 'label': 'Create .gitignore', 'command':'bacadra-tools:create-gitignore' }
  ]
  '.tree-view-root.multi-select': [
    { 'label': 'Create .gitignore', 'command':'bacadra-tools:create-gitignore' }
  ]

'menu': [
  {
    label: 'Packages'
    submenu: [
      {
        label: 'Bacadra Tools'
        submenu: [
          { label: 'Open CALC', command: 'bacadra-tools:open-CALC' }
          { label: 'Open FUND', command: 'bacadra-tools:open-FUND' }
          { label: 'Open TODO', command: 'bacadra-tools:open-TODO' }
          { label: 'Open YTDL', command: 'bacadra-tools:open-YTDL' }
          { label: 'Unicode Readme', command: 'bacadra-tools:unicode-readme' }
          { label: 'Toggle Ligatures', command: 'bacadra-tools:ligatures' }
          { label: 'Reopen in Dev Mode', command: 'bacadra-tools:reopen-in-dev-mode' }
          { label: 'Signer', command: 'bacadra-tools:signer' }
          { label: 'Revert', command: 'bacadra-tools:revert' }
          { label: 'CDB Clear', command: 'bacadra-tools:cdb-clear' }
          { label: 'Normalize Newlines', command: 'bacadra-tools:normalize-newlines' }
          { label: 'Generalize Cites', command: 'bacadra-tools:generalize-cites' }
        ]
      }
